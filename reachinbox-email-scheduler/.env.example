# ─────────────────────────────────────────────────────────────
# ReachInbox Email Scheduler — Environment Variables Example
# Copy this file to .env and fill in your real values
# NEVER commit .env to version control
# ─────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
FRONTEND_URL=http://localhost:5173

# ── PostgreSQL ────────────────────────────────────────────────
POSTGRES_USER=reachinbox
POSTGRES_PASSWORD=reachinbox_secret
POSTGRES_DB=reachinbox
DATABASE_URL="postgresql://reachinbox:reachinbox_secret@localhost:5432/reachinbox?schema=public"

# ── Redis ─────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret

# ── Elasticsearch ─────────────────────────────────────────────
ELASTICSEARCH_URL=http://localhost:9200

# ── BullMQ Worker ────────────────────────────────────────────
WORKER_CONCURRENCY=10
MIN_EMAIL_DELAY_MS=2000
MAX_EMAILS_PER_HOUR_PER_SENDER=100

# ── Google OAuth ──────────────────────────────────────────────
# Create credentials at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# ── Slack OAuth ───────────────────────────────────────────────
# Create app at https://api.slack.com/apps
SLACK_CLIENT_ID=your-slack-client-id
SLACK_CLIENT_SECRET=your-slack-client-secret
SLACK_REDIRECT_URI=http://localhost:4000/api/slack/callback

# ── Ethereal Email ────────────────────────────────────────────
# Auto-created per sender, but you can set a default fallback
ETHEREAL_USER=your-ethereal-username
ETHEREAL_PASSWORD=your-ethereal-password

# ── Session ───────────────────────────────────────────────────
SESSION_SECRET=change-this-to-a-long-random-string-in-production
