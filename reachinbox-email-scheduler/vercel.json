{
  "version": 2,
  "buildCommand": "npm run build:frontend",
  "outputDirectory": "apps/frontend/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://reachinbox-backend.onrender.com/api/:path*"
    },
    {
      "source": "/health",
      "destination": "https://reachinbox-backend.onrender.com/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
